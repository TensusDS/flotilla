{
  "event_schema": 1,
  "events": [
    "pre-reserved",
    "post-reserved",
    "pre-claimed",
    "post-claimed",
    "pre-handed",
    "post-handed",
    "pre-fixing",
    "post-fixing",
    "pre-accepted",
    "post-accepted",
    "pre-queued",
    "post-queued",
    "pre-landed",
    "post-landed",
    "pre-shipped",
    "post-shipped",
    "pre-walked",
    "post-walked",
    "pre-closed",
    "post-closed",
    "pre-released",
    "post-released",
    "pre-offledger",
    "post-offledger",
    "pre-inbatch",
    "post-inbatch"
  ],
  "exit": {
    "0": "allow the move (pre-); nothing (post-)",
    "2": "reject the move (pre- only); what the script printed is shown",
    "other": "the script is broken: a pre- script refuses the move and is named; a post- failure is printed and counted"
  },
  "stdin": {
    "by": "string: the session that made the move",
    "event": "string: the script's own name, pre-<state> or post-<state>",
    "event_schema": "integer: the version of this contract",
    "evidence": "object: the move's evidence",
    "move": "string: the ledger move, for example hand or ship",
    "post": "string: its post",
    "repo": "string: the repository key",
    "row": {
      "adopted_from": "string",
      "after": "array",
      "approved": "string",
      "base": "string",
      "branch": "string",
      "broken": "string",
      "fixes": "string",
      "gate": "string",
      "held_by": "string",
      "held_until": "string",
      "held_why": "string",
      "helper_of": "string",
      "id": "string",
      "last_run": "string",
      "merge": "string",
      "note": "string",
      "owner": "string",
      "pr": "string",
      "reader": "string",
      "ref": "string",
      "requires": "array",
      "session_id": "string",
      "taken": "boolean",
      "tip": "string",
      "tree": "string",
      "urgent_at": "string",
      "urgent_why": "string",
      "verdict": "string",
      "vouched": "array",
      "waiting_on": "string",
      "walkable": "string",
      "why": "string"
    },
    "state": "string: the state the move enters",
    "trunk": "string: the trunk branch"
  },
  "timeout_seconds": 30.0
}

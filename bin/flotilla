#!/usr/bin/env python3
# flotilla entry point. This file keeps to syntax any Python 3 can parse (no f-strings, no
# walrus, no match), so an interpreter older than the floor reaches the message below instead
# of dying on a SyntaxError that names nothing the user can act on.
import os
import sys

MINIMUM = (3, 11)
#: flotilla.guards.PUSH_WORDS, for a guard hook that fails before flotilla can be imported (a test keeps them equal)
PUSH_WORDS = ("push", "gh")
#: flotilla.guards.PERSON_WORDS, kept equal the same way
PERSON_WORDS = ("approve", "rig", "attention", "fleet")


def guard_answer(data, why):
    """The guard hook's answer when flotilla itself cannot judge: a command that may push is refused, with no
    override - nothing was judged, so neither the command's text nor the environment waives anything; a line that
    may hold a move only the person makes is put to the person; anything else runs, and the session is told. A
    message on stdout alone, or an exit code, is no refusal to Claude Code (review of 0.7.9)."""
    import json
    command = ""
    try:
        payload = json.loads(data or "{}")
        tool_input = payload.get("tool_input") if isinstance(payload, dict) else None
        if isinstance(tool_input, dict) and isinstance(tool_input.get("command"), str):
            command = tool_input["command"]
    except Exception:
        command = ""
    import re
    # flotilla.guards.unquoted: a word split by quotes or a backslash is still found (a test keeps the two equal)
    bare = command.replace("\\\n", "").replace("'", "").replace('"', "").replace("\\", "")
    refuse = any(word in bare for word in PUSH_WORDS)
    if "$" in bare or "`" in bare:   # as flotilla.guards.may_be_persons: the word anywhere is enough
        persons = any(word in bare for word in PERSON_WORDS)
    else:
        words = re.compile(r"\b(?:%s)\b" % "|".join(PERSON_WORDS))
        blanked = re.sub(r"\\(?:x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|[0-7]{1,3}|[\s\S])", " ", command)
        blanked = blanked.replace("'", "").replace('"', "")
        persons = "flotilla" in bare and (words.search(bare) or words.search(blanked)) is not None
    ask = not refuse and persons
    text = "flotilla guards failed (" + why.strip() + "); " + (
        "a command that may push is refused on failure. Knowingly: the person runs the command themselves - "
        "with `!` in front, or in a terminal. Where flotilla's pre-push hook is installed, it judges a "
        "`git push` again" if refuse
        else "this line may hold a move only the person makes (`work approve`, a `rig` move, `attention`, "
             "`fleet model <name>`) and it could not be read, so the person decides whether it runs" if ask
        else "the command runs unchecked")
    if refuse:
        body = {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": text}
    elif ask:
        body = {"hookEventName": "PreToolUse", "permissionDecision": "ask", "permissionDecisionReason": text}
    else:
        body = {"hookEventName": "PreToolUse", "additionalContext": text}
    return json.dumps({"hookSpecificOutput": body}) + "\n"


def project_found(start):
    """Whether .flotilla/project.toml exists at or above `start` (activation, old-Python safe)."""
    current = os.path.realpath(start)
    while True:
        if os.path.isfile(os.path.join(current, ".flotilla", "project.toml")):
            return True
        parent = os.path.dirname(current)
        if parent == current:
            return False
        current = parent


def main():
    guard = sys.argv[1:3] == ["hook", "guard"]
    data = sys.stdin.read() if guard else None
    if sys.version_info < MINIMUM:
        found = "%d.%d.%d" % tuple(sys.version_info[:3])
        message = (
            "flotilla needs Python %d.%d or newer; this python3 is %s (%s).\n"
            "Install one with `brew install python` (macOS) or `uv python install 3.11`, "
            "and make it the python3 on PATH.\n" % (MINIMUM[0], MINIMUM[1], found, sys.executable))
        if sys.argv[1:2] == ["hook"]:
            # Installed is not active, even on an old interpreter: outside an onboarded project a
            # hook stays silent; inside one it tells the session on stdout, the channel it reads.
            cwd = None
            try:
                import json
                payload = json.loads(data) if guard else json.load(sys.stdin)
                if isinstance(payload, dict) and isinstance(payload.get("cwd"), str):
                    cwd = payload["cwd"]
            except Exception:
                cwd = None
            if not project_found(cwd or os.getcwd()):
                return 0
            if guard:
                sys.stdout.write(guard_answer(data, message))
                return 0
            sys.stdout.write("flotilla: " + message)
            return 0
        sys.stderr.write(message)
        return 3
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    sys.path.insert(0, root)
    if not guard:
        from flotilla.cli import main as cli_main
        return cli_main(sys.argv[1:])
    import io
    sys.stdin = io.StringIO(data)
    try:
        from flotilla.cli import main as cli_main
        return cli_main(sys.argv[1:])
    except Exception as err:   # an import or a crash the hook could not catch itself: decided here, not lost
        sys.stdout.write(guard_answer(data, "%s: %s" % (type(err).__name__, err)))
        return 0


if __name__ == "__main__":
    sys.exit(main())
